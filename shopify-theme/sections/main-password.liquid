<section class="password section-pad">
  <div class="container center">
    <p class="display display-xl text-lime">{{ shop.name }}</p>
    <p class="lead">{{ shop.password_message | default: 'Bientôt en ligne.' }}</p>
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="visually-hidden" for="password">Mot de passe</label>
      <input id="password" type="password" name="password" placeholder="Mot de passe" autocomplete="current-password">
      {%- render 'button', tag: 'button', label: 'Entrer' -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Mot de passe" }
{% endschema %}
