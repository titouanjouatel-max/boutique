<section class="page-shell section-pad">
  <div class="container container--text">
    <h1 class="display display-lg text-obsidian">Nouveau mot de passe</h1>
    {%- form 'reset_customer_password', class: 'contact-form' -%}
      {{ form.errors | default_errors }}
      <label>Mot de passe<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label>Confirmation<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      {%- render 'button', tag: 'button', label: 'Enregistrer', arrow: true -%}
    {%- endform -%}
  </div>
</section>
