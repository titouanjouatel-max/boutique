<section class="page-shell section-pad">
  <div class="container container--text">
    <h1 class="display display-lg text-obsidian">Créer un compte</h1>
    {%- form 'create_customer', class: 'contact-form' -%}
      {{ form.errors | default_errors }}
      <label>Prénom<input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label>Nom<input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label>E-mail<input type="email" name="customer[email]" autocomplete="email" required></label>
      <label>Mot de passe<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      {%- render 'button', tag: 'button', label: 'Créer mon compte', arrow: true -%}
    {%- endform -%}
  </div>
</section>
